# Env vars the legacy server already depends on but never documented
# (server/config/local.env.sample.js doesn't list these).
PORT=4000
SOCRATA_USERNAME=
SOCRATA_PASSWORD=
SOCRATA_APP_TOKEN_MTC=
VMT_DATA_KEY=

# No DATABASE_URL — the new API stays stateless. Feedback (plan Task 5)
# is brought in-house but backed by Asana, not a database - see below.

# Feedback submissions (web/app/(public)/feedback) are posted as tasks
# in this Asana project via api/src/routes/feedback.ts, instead of the
# legacy external Elastic Beanstalk service. ASANA_ACCESS_TOKEN is a
# Personal Access Token (https://app.asana.com/0/my-apps) for the
# account that should own these tasks. ASANA_PROJECT_ID is the target
# project's gid - intentionally left blank here; fill in once the
# project is created/chosen.
ASANA_ACCESS_TOKEN=
ASANA_PROJECT_ID=

# --- web workspace (Task 4) ---

# Where the api workspace actually runs; web/next.config.js rewrites
# /api/* to this server-side, so the browser never talks to it directly
# and no CORS configuration is needed there.
API_INTERNAL_URL=http://localhost:4000

# Mapbox GL JS access token for the /map page. Public by design (Mapbox
# tokens are meant to be used client-side, restricted via URL/referrer
# rules on the Mapbox account), but must be set explicitly here — the
# legacy client/app/map/map.component.js hardcoded a token directly in
# source instead. That token is already public (shipped in every legacy
# page load); reusing it here wasn't done deliberately, so whoever owns
# the Mapbox account should issue a fresh token for this app and verify
# the legacy one's referrer restrictions.
NEXT_PUBLIC_MAPBOX_TOKEN=
