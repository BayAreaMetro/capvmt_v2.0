# Server-side environment variables (see web/lib/env.ts). Read directly
# by this app's Route Handlers (web/app/api/*) - no separate API service.
SOCRATA_USERNAME=
SOCRATA_PASSWORD=
SOCRATA_APP_TOKEN_MTC=
VMT_DATA_KEY=

# No DATABASE_URL — the app stays stateless. Feedback is backed by
# Asana, not a database - see below.

# Feedback submissions are posted as tasks in this Asana project via
# web/app/api/feedback/route.ts, instead of a database. ASANA_ACCESS_TOKEN
# is a Personal Access Token (https://app.asana.com/0/my-apps) for the
# account that should own these tasks. ASANA_PROJECT_ID is the target
# project's gid - intentionally left blank here; fill in once the
# project is created/chosen.
ASANA_ACCESS_TOKEN=
ASANA_PROJECT_ID=

# Mapbox GL JS access token for the /map page. Public by design (Mapbox
# tokens are meant to be used client-side, restricted via URL/referrer
# rules on the Mapbox account), but must be set explicitly here — the
# source. Whoever owns the Mapbox account should issue a token for this
# app and verify its referrer restrictions.
NEXT_PUBLIC_MAPBOX_TOKEN=
